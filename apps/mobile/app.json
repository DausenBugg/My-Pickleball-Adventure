{
  "expo": {
    "name": "My Pickleball App",
    "slug": "my-pickleball-adventure",
    "scheme": "my-pickleball-adventure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dbugg.mypickleballadventure",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.dbugg.mypickleballadventure",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/branding/app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0e4cabb7-6d47-44af-bcc5-0f7c18dee1b6"
      },
      "router": {}
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#FF6B6B"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7596986183502466~7745740291"
        }
      ]
    ],
    "owner": "dbugg"
  }
}
